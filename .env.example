# ==============================================================================
# AUTONOMOUS API - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development"                  # Environment: "development", "production", "test"
PORT=3000                               # API internal port
APP_NAME="autonomous-api"
APP_URL="http://localhost:3000"
API_PREFIX="api"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 18 & Prisma 7)
# ------------------------------------------------------------------------------
# Prisma 7 Database Connection URL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://autonomous:change_this_in_production_secure_pass_2026@localhost:5432/autonomous_db?schema=public"

# ------------------------------------------------------------------------------
# 3. CACHE & ASYNC QUEUES (Redis 7 + BullMQ)
# ------------------------------------------------------------------------------
# Redis URL format: redis://:[password]@[host]:[port]/[db]
REDIS_URL="redis://:change_redis_pass_in_production_2026@localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (JWT, CORS, RATE LIMITING)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret (e.g. `openssl rand -hex 32`)
JWT_SECRET="generate_a_very_long_and_secure_random_string_here_min_32_chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# CORS Allowed Origins (comma-separated domains: web portals, mobile capacitor://localhost, etc.)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,capacitor://localhost"

# Rate Limiter (Throttler)
THROTTLE_TTL=60                         # Window duration in seconds
THROTTLE_LIMIT=100                      # Max requests per window per IP

# ------------------------------------------------------------------------------
# 5. REVERSE PROXY & DEPLOYMENT (Nginx & Coolify)
# ------------------------------------------------------------------------------
HTTP_PORT=80                            # Public port exposed by Nginx
CLIENT_MAX_BODY_SIZE="50M"              # Max upload payload size
RUN_MIGRATIONS="true"                   # Automatically run `prisma migrate deploy` on startup

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEGRATIONS (Payment Gateway, SMS, Email)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_URL="https://api.paymentgateway.example.com"
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_GATEWAY_WEBHOOK_SECRET=""

# Ombala SMS Gateway (Angola)
OMBALA_BASE_URL="https://api.useombala.ao"
OMBALA_API_TOKEN="your_ombala_api_token_here"
OMBALA_FROM="your_ombala_sender_id_here"

EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="noreply@autonomous.example.com"
